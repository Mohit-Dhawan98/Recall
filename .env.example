# Database
DB_PASSWORD=change-me-secure-password

# API Security
SECRET_KEY=change-me-to-random-string

# LLM Configuration (choose one)
# Option 1: DeepSeek API (recommended - cheap and fast)
DEEPSEEK_API_KEY=your-deepseek-api-key

# Option 2: Local Ollama (free, run with: docker-compose --profile local-llm up)
# OLLAMA_URL=http://ollama:11434

# Public URL (required for multi-device access)
# Set this to your tunnel URL (Cloudflare, Tailscale, ngrok, etc.)
PUBLIC_URL=http://localhost:3000

# Telegram Bot (optional - run with: docker-compose --profile with-bot up)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Your Telegram user ID (message @userinfobot on Telegram to get it)
TELEGRAM_OWNER_USER_ID=your-telegram-user-id
USE_POLLING=true

# Tailscale (if using tailscale tunnel)
# TAILSCALE_AUTHKEY=tskey-xxx
